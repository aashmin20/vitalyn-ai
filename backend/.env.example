# Copy to backend/.env (git-ignored) and fill in. NEVER commit the real file.
#
# Leave DATABASE_URL unset to use the local SQLite file (development, demos, tests).
# To use Supabase, paste the connection string from:
#   Supabase dashboard > your project > Connect > "Session pooler" (works over IPv4)
# It looks like:
#   postgresql://postgres.<project-ref>:<YOUR-DB-PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_URL=

# Phone cameras (patient QR codes): set to 1 to start the HTTPS phone gateway on port 8443.
# VITALYN_PHONE_GATEWAY=1

# Staff sign-in (Supabase Auth). Use scripts/set_supabase_auth.py to fill these; public anon key only.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_JWT_SECRET=   (optional, legacy HS256 projects)
# VITALYN_AUTH=off       (open demo with no login; never for anything shared)
# VITALYN_AUTO_APPROVE=off  (new sign-ups wait for an administrator; default: active at once)
# VITALYN_DEFAULT_ROLE=doctor  (role given to auto-approved accounts; the first account becomes admin)
